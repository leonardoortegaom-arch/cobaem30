<!DOCTYPE html>
<html lang="es">

<%- include('../partials/head', { title }) %>

<body>

<div class="dashboard-layout">

  <%- include('../partials/sidebar', { menuItems }) %>

  <main class="dashboard-main">

    <header class="dashboard-header">
      <div>
        <h1>Mi cuenta</h1>
        <p>Consulta tus datos y actualiza tu contraseña de acceso.</p>
      </div>
    </header>

    <section class="panel-card account-card">
      <dl class="admin-user-summary">
        <div>
          <dt>Nombre completo</dt>
          <dd><%= [usuarioCuenta.nombre, usuarioCuenta.apellido_paterno, usuarioCuenta.apellido_materno].filter(Boolean).join(' ') %></dd>
        </div>
        <div>
          <dt>Correo</dt>
          <dd><%= usuarioCuenta.correo %></dd>
        </div>
        <div>
          <dt>Rol</dt>
          <dd><%= usuarioCuenta.rolNombre %></dd>
        </div>
        <div>
          <dt>Estado</dt>
          <dd><%= usuarioCuenta.activo ? 'Activo' : 'Inactivo' %></dd>
        </div>
      </dl>

      <% if (usuarioCuenta.rol === 'ALUMNO') { %>
        <h2>Perfil académico</h2>

        <% if (perfilAcademico) { %>
          <dl class="admin-user-summary">
            <div>
              <dt>Matrícula</dt>
              <dd><%= perfilAcademico.matricula %></dd>
            </div>
            <div>
              <dt>Grupo</dt>
              <dd><%= perfilAcademico.grupoClave %></dd>
            </div>
            <div>
              <dt>Semestre</dt>
              <dd><%= perfilAcademico.semestre %></dd>
            </div>
            <div>
              <dt>Turno</dt>
              <dd><%= perfilAcademico.turno %></dd>
            </div>
            <div>
              <dt>Ciclo escolar</dt>
              <dd><%= perfilAcademico.cicloEscolar %></dd>
            </div>
            <div>
              <dt>Estado del grupo</dt>
              <dd><%= perfilAcademico.grupoActivo ? 'Activo' : 'Inactivo' %></dd>
            </div>
          </dl>
        <% } else { %>
          <div class="alert alert-warning" role="status">
            El perfil académico no está disponible en este momento.
          </div>
        <% } %>
      <% } %>

      <% if (usuarioCuenta.rol !== 'ALUMNO') { %>
        <h2>Cambiar contraseña</h2>

        <% if (error) { %>
          <div class="alert alert-danger" role="alert">
            <%= error %>
          </div>
        <% } %>

        <form method="POST" action="/mi-cuenta/contrasena">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="admin-form-grid">
            <div class="admin-form-group admin-form-group-full">
              <label for="password_actual">Contraseña actual</label>
              <input id="password_actual" name="password_actual" type="password" autocomplete="current-password" required>
            </div>

            <div class="admin-form-group">
              <label for="password_nueva">Nueva contraseña</label>
              <input id="password_nueva" name="password_nueva" type="password" autocomplete="new-password" required minlength="12">
            </div>

            <div class="admin-form-group">
              <label for="password_confirmacion">Confirmar nueva contraseña</label>
              <input id="password_confirmacion" name="password_confirmacion" type="password" autocomplete="new-password" required minlength="12">
            </div>
          </div>

          <p class="admin-form-note">La nueva contraseña debe tener al menos 12 caracteres y no superar 72 bytes.</p>

          <div class="admin-form-actions">
            <button type="submit" class="btn-admin-primary">Cambiar contraseña</button>
          </div>
        </form>
      <% } %>
    </section>

  </main>

</div>

</body>
</html>
