<% if(paginacion.totalPaginas>1){ %><nav class="admin-pagination" aria-label="Paginación"><% if(paginacion.tieneAnterior){ %><a href="<%= paginacion.urlAnterior %>" class="admin-page-link">Anterior</a><% } %><% paginacion.enlaces.forEach(e=>{ %><a href="<%= e.url %>" class="admin-page-link <%= e.actual?'active':'' %>" <%= e.actual?'aria-current="page"':'' %>><%= e.numero %></a><% }); %><% if(paginacion.tieneSiguiente){ %><a href="<%= paginacion.urlSiguiente %>" class="admin-page-link">Siguiente</a><% } %></nav><% } %>
