<!DOCTYPE html><html lang="es">
<%- include('../../partials/head', { title }) %><body><div class="dashboard-layout">
<%- include('../../partials/sidebar', { menuItems }) %><main class="dashboard-main">
<header class="dashboard-header"><div><h1>Administración de aulas</h1><p>Consulta y administra los espacios disponibles para la programación académica.</p></div></header>
<% if (mensaje) { %><div class="alert alert-success" role="alert"><%= mensaje %></div><% } %>
<section class="panel-card"><div class="panel-header"><h3>Aulas registradas</h3><a href="/admin/aulas/nuevo" class="btn-admin-primary">Registrar aula</a></div>
<form method="GET" action="/admin/aulas" class="admin-user-filters">
<div class="admin-filter-field admin-filter-search"><label for="aula-q">Buscar</label><input id="aula-q" name="q" type="search" maxlength="150" value="<%= filtros.q %>" placeholder="Clave o nombre"></div>
<div class="admin-filter-field"><label for="aula-estado">Estado</label><select id="aula-estado" name="estado"><option value="">Todos</option><option value="activo" <%= filtros.estado === 'activo' ? 'selected' : '' %>>Activos</option><option value="inactivo" <%= filtros.estado === 'inactivo' ? 'selected' : '' %>>Inactivos</option></select></div>
<div class="admin-filter-actions"><button type="submit" class="btn-admin-primary">Buscar</button><a href="/admin/aulas" class="btn-admin-secondary">Limpiar</a></div></form>
<p class="admin-results-count"><%= paginacion.totalRegistros %> aulas encontradas</p><div class="table-responsive"><table class="custom-table"><thead><tr><th>Clave</th><th>Nombre</th><th>Descripción</th><th>Estado</th><th>Fecha de registro</th><th>Acciones</th></tr></thead><tbody>
<% if (aulas.length === 0) { %><tr><td colspan="6" class="text-center">No se encontraron aulas.</td></tr><% } else { aulas.forEach((aula) => { %><tr>
<td><%= aula.clave %></td><td><%= aula.nombre %></td><td><%= aula.descripcion || 'Sin descripción' %></td><td><span class="badge-custom <%= aula.activo ? 'success' : 'warning' %>"><%= aula.activo ? 'Activo' : 'Inactivo' %></span></td><td><%= new Date(aula.creado_en).toLocaleString('es-MX') %></td>
<td><div class="admin-table-actions"><a href="/admin/aulas/<%= aula.id %>/editar" class="btn-admin-edit">Editar</a><a href="/admin/aulas/<%= aula.id %>/estado" class="<%= aula.activo ? 'btn-admin-state-danger' : 'btn-admin-state-activate' %>"><%= aula.activo ? 'Desactivar' : 'Activar' %></a></div></td></tr><% }); } %>
</tbody></table></div>
<% if (paginacion.totalPaginas > 1) { %><nav class="admin-pagination" aria-label="Paginación de aulas"><% if (paginacion.tieneAnterior) { %><a href="<%= paginacion.urlAnterior %>" class="admin-page-link">Anterior</a><% } else { %><span class="admin-page-link disabled">Anterior</span><% } %><% paginacion.enlaces.forEach((e) => { %><a href="<%= e.url %>" class="admin-page-link <%= e.actual ? 'active' : '' %>" <%= e.actual ? 'aria-current="page"' : '' %>><%= e.numero %></a><% }); %><% if (paginacion.tieneSiguiente) { %><a href="<%= paginacion.urlSiguiente %>" class="admin-page-link">Siguiente</a><% } else { %><span class="admin-page-link disabled">Siguiente</span><% } %></nav><% } %>
</section></main></div></body></html>
