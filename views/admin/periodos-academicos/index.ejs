<!DOCTYPE html><html lang="es"><%- include('../../partials/head',{title}) %><body><div class="dashboard-layout"><%- include('../../partials/sidebar',{menuItems}) %><main class="dashboard-main"><header class="dashboard-header"><div><h1>Calendario académico</h1><p>Administra periodos contenidos en ciclos escolares activos.</p></div></header><%- include('../calendario/_nav') %><% if(mensaje){ %><div class="alert alert-success"><%= mensaje %></div><% } %><section class="panel-card"><div class="panel-header"><h2>Periodos académicos</h2><a href="/admin/periodos-academicos/nuevo" class="btn-admin-primary">Registrar periodo</a></div><form method="GET" class="admin-user-filters"><div class="admin-filter-field"><label for="q">Buscar</label><input id="q" name="q" value="<%= filtros.q %>" maxlength="100"></div><div class="admin-filter-field"><label for="ciclo">Ciclo</label><select id="ciclo" name="ciclo"><option value="">Todos</option><% ciclos.forEach(c=>{ %><option value="<%= c.id %>" <%= Number(filtros.ciclo)===Number(c.id)?'selected':'' %>><%= c.clave %> · <%= c.nombre %></option><% }); %></select></div><div class="admin-filter-field"><label for="estado">Estado</label><select id="estado" name="estado"><option value="">Todos</option><option value="activo" <%= filtros.estado==='activo'?'selected':'' %>>Activos</option><option value="inactivo" <%= filtros.estado==='inactivo'?'selected':'' %>>Inactivos</option></select></div><div class="admin-filter-actions"><button class="btn-admin-primary">Buscar</button><a href="/admin/periodos-academicos" class="btn-admin-secondary">Limpiar</a></div></form><p class="admin-results-count"><%= paginacion.totalRegistros %> periodos encontrados</p><div class="table-responsive"><table class="custom-table"><thead><tr><th>Clave</th><th>Nombre</th><th>Ciclo</th><th>Inicio</th><th>Fin</th><th>Estado</th><th>Acciones</th></tr></thead><tbody><% if(!periodos.length){ %><tr><td colspan="7" class="text-center">No se encontraron periodos académicos.</td></tr><% }else periodos.forEach(p=>{ %><tr><td><%= p.clave %></td><td><%= p.nombre %></td><td><%= p.ciclo_clave %></td><td><%= String(p.fecha_inicio).slice(0,10) %></td><td><%= String(p.fecha_fin).slice(0,10) %></td><td><span class="badge-custom <%= p.activo?'success':'warning' %>"><%= p.activo?'Activo':'Inactivo' %></span></td><td><div class="admin-table-actions"><a href="/admin/periodos-academicos/<%= p.id %>/editar" class="btn-admin-edit">Editar</a><a href="/admin/periodos-academicos/<%= p.id %>/estado" class="<%= p.activo?'btn-admin-state-danger':'btn-admin-state-activate' %>"><%= p.activo?'Desactivar':'Activar' %></a></div></td></tr><% }); %></tbody></table></div><%- include('../calendario/_pagination',{paginacion}) %></section></main></div></body></html>
