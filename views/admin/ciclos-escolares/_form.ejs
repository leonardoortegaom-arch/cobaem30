<% if(error){ %><div class="alert alert-danger"><%= error %></div><% } %><form method="POST" action="<%= accion %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="admin-form-grid"><div class="admin-form-group"><label for="clave">Clave</label><input id="clave" name="clave" maxlength="30" value="<%= datos.clave %>" required></div><div class="admin-form-group"><label for="nombre">Nombre</label><input id="nombre" name="nombre" maxlength="100" value="<%= datos.nombre %>" required></div><div class="admin-form-group"><label for="fecha_inicio">Fecha inicial</label><input id="fecha_inicio" name="fecha_inicio" type="date" value="<%= datos.fechaInicio %>" required></div><div class="admin-form-group"><label for="fecha_fin">Fecha final</label><input id="fecha_fin" name="fecha_fin" type="date" value="<%= datos.fechaFin %>" required></div></div><div class="admin-form-actions"><button class="btn-admin-primary"><%= boton %></button><a href="/admin/ciclos-escolares" class="btn-admin-secondary">Cancelar</a></div></form>
