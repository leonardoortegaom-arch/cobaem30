<!DOCTYPE html><html lang="es"><%- include('../../partials/head',{title}) %><body><div class="dashboard-layout"><%- include('../../partials/sidebar',{menuItems}) %><main class="dashboard-main"><header class="dashboard-header"><h1>Estado del ciclo escolar</h1></header><section class="panel-card admin-form-card"><h2>¿Deseas <%= accion %> <%= ciclo.clave %>?</h2><p>Un ciclo con periodos activos no puede desactivarse.</p><form method="POST" action="/admin/ciclos-escolares/<%= ciclo.id %>/estado"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="accion" value="<%= accion %>"><div class="admin-form-actions"><button class="<%= accion==='desactivar'?'btn-admin-danger':'btn-admin-activate' %>"><%= accion==='desactivar'?'Desactivar ciclo':'Activar ciclo' %></button><a href="/admin/ciclos-escolares" class="btn-admin-secondary">Cancelar</a></div></form></section></main></div></body></html>
