<!DOCTYPE html><html lang="es"><%- include('../../partials/head',{title}) %><body><div class="dashboard-layout"><%- include('../../partials/sidebar',{menuItems}) %><main class="dashboard-main"><header class="dashboard-header"><div><h1>Calendario académico</h1><p>Administra los ciclos escolares institucionales.</p></div></header><%- include('../calendario/_nav') %><% if(mensaje){ %><div class="alert alert-success"><%= mensaje %></div><% } %><section class="panel-card"><div class="panel-header"><h2>Ciclos escolares</h2><a href="/admin/ciclos-escolares/nuevo" class="btn-admin-primary">Registrar ciclo</a></div><form method="GET" class="admin-user-filters"><div class="admin-filter-field"><label for="q">Buscar</label><input id="q" name="q" value="<%= filtros.q %>" maxlength="100"></div><div class="admin-filter-field"><label for="estado">Estado</label><select id="estado" name="estado"><option value="">Todos</option><option value="activo" <%= filtros.estado==='activo'?'selected':'' %>>Activos</option><option value="inactivo" <%= filtros.estado==='inactivo'?'selected':'' %>>Inactivos</option></select></div><div class="admin-filter-actions"><button class="btn-admin-primary">Buscar</button><a href="/admin/ciclos-escolares" class="btn-admin-secondary">Limpiar</a></div></form><p class="admin-results-count"><%= paginacion.totalRegistros %> ciclos encontrados</p><div class="table-responsive"><table class="custom-table"><thead><tr><th>Clave</th><th>Nombre</th><th>Inicio</th><th>Fin</th><th>Estado</th><th>Acciones</th></tr></thead><tbody><% if(!ciclos.length){ %><tr><td colspan="6" class="text-center">No se encontraron ciclos escolares.</td></tr><% }else ciclos.forEach(c=>{ %><tr><td><%= c.clave %></td><td><%= c.nombre %></td><td><%= String(c.fecha_inicio).slice(0,10) %></td><td><%= String(c.fecha_fin).slice(0,10) %></td><td><span class="badge-custom <%= c.activo?'success':'warning' %>"><%= c.activo?'Activo':'Inactivo' %></span></td><td><div class="admin-table-actions"><a href="/admin/ciclos-escolares/<%= c.id %>/editar" class="btn-admin-edit">Editar</a><a href="/admin/ciclos-escolares/<%= c.id %>/estado" class="<%= c.activo?'btn-admin-state-danger':'btn-admin-state-activate' %>"><%= c.activo?'Desactivar':'Activar' %></a></div></td></tr><% }); %></tbody></table></div><%- include('../calendario/_pagination',{paginacion}) %></section></main></div></body></html>
