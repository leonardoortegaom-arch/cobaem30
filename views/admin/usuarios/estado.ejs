<!DOCTYPE html>
<html lang="es">

<%- include('../../partials/head', { title }) %>

<body>

<div class="dashboard-layout">

  <%- include('../../partials/sidebar', { menuItems }) %>

  <main class="dashboard-main">

    <header class="dashboard-header">
      <div>
        <h1>Estado de usuario</h1>
        <p>Confirma el cambio de acceso para esta cuenta.</p>
      </div>
    </header>

    <section class="panel-card admin-confirmation-card">
      <% if (error) { %>
        <div class="alert alert-danger" role="alert">
          <%= error %>
        </div>
      <% } %>

      <dl class="admin-user-summary">
        <div>
          <dt>Nombre</dt>
          <dd><%= [usuarioObjetivo.nombre, usuarioObjetivo.apellido_paterno, usuarioObjetivo.apellido_materno].filter(Boolean).join(' ') %></dd>
        </div>
        <div>
          <dt>Correo</dt>
          <dd><%= usuarioObjetivo.correo %></dd>
        </div>
        <div>
          <dt>Rol</dt>
          <dd><%= usuarioObjetivo.rol_nombre %></dd>
        </div>
        <div>
          <dt>Estado actual</dt>
          <dd><%= usuarioObjetivo.activo ? 'Activo' : 'Inactivo' %></dd>
        </div>
      </dl>

      <h2>¿Deseas <%= accion %> esta cuenta?</h2>
      <p>Una cuenta inactiva no podrá iniciar sesión en la plataforma.</p>

      <% if (!error) { %>
        <form method="POST" action="/admin/usuarios/<%= usuarioObjetivo.id %>/estado">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="accion" value="<%= accion %>">

          <div class="admin-form-actions">
            <button type="submit" class="<%= accion === 'desactivar' ? 'btn-admin-danger' : 'btn-admin-activate' %>">
              <%= accion === 'desactivar' ? 'Desactivar cuenta' : 'Activar cuenta' %>
            </button>
            <a href="/admin/usuarios" class="btn-admin-secondary">Cancelar</a>
          </div>
        </form>
      <% } else { %>
        <div class="admin-form-actions">
          <a href="/admin/usuarios" class="btn-admin-secondary">Cancelar</a>
        </div>
      <% } %>
    </section>

  </main>

</div>

</body>
</html>
