<!DOCTYPE html>
<html lang="es">

<%- include('../../partials/head', { title }) %>

<body>

<div class="dashboard-layout">

  <%- include('../../partials/sidebar', { menuItems }) %>

  <main class="dashboard-main">

    <header class="dashboard-header">
      <div>
        <h1>Crear usuario</h1>
        <p>Registra un nuevo usuario y asígnale su rol dentro de la plataforma.</p>
      </div>
    </header>

    <section class="panel-card admin-form-card">
      <% if (error) { %>
        <div class="alert alert-danger" role="alert">
          <%= error %>
        </div>
      <% } %>

      <form method="POST" action="/admin/usuarios">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="admin-form-grid">
          <div class="admin-form-group">
            <label for="nombre">Nombre</label>
            <input id="nombre" name="nombre" type="text" value="<%= datos.nombre %>" required maxlength="100" autocomplete="given-name">
          </div>

          <div class="admin-form-group">
            <label for="apellido_paterno">Apellido paterno</label>
            <input id="apellido_paterno" name="apellido_paterno" type="text" value="<%= datos.apellido_paterno %>" required maxlength="80" autocomplete="family-name">
          </div>

          <div class="admin-form-group">
            <label for="apellido_materno">Apellido materno</label>
            <input id="apellido_materno" name="apellido_materno" type="text" value="<%= datos.apellido_materno %>" maxlength="80" autocomplete="additional-name">
          </div>

          <div class="admin-form-group">
            <label for="correo">Correo</label>
            <input id="correo" name="correo" type="email" value="<%= datos.correo %>" required maxlength="150" autocomplete="username">
          </div>

          <div class="admin-form-group admin-form-group-full">
            <label for="rol_id">Rol</label>
            <select id="rol_id" name="rol_id" required>
              <option value="" disabled <%= datos.rol_id ? '' : 'selected' %>>Selecciona un rol</option>
              <% roles.forEach((rol) => { %>
                <option value="<%= rol.id %>" data-clave="<%= rol.clave %>" <%= String(datos.rol_id) === String(rol.id) ? 'selected' : '' %>><%= rol.nombre %></option>
              <% }); %>
            </select>
          </div>

          <div id="datos-alumno" class="admin-form-group-full">
            <h2>Datos del alumno</h2>
            <p class="admin-form-note">Estos datos se aplican únicamente cuando el rol seleccionado es Alumno.</p>
          </div>

          <div class="admin-form-group" data-alumno-field>
            <label for="matricula">Matrícula</label>
            <input id="matricula" name="matricula" type="text" inputmode="numeric" pattern="[0-9]{9}" maxlength="9" value="<%= datos.matricula %>" autocomplete="off">
          </div>

          <div class="admin-form-group" data-alumno-field>
            <label for="grupo_id">Grupo actual</label>
            <select id="grupo_id" name="grupo_id">
              <option value="" disabled <%= datos.grupo_id ? '' : 'selected' %>>Selecciona un grupo activo</option>
              <% grupos.forEach((grupo) => { %>
                <option value="<%= grupo.id %>" <%= String(datos.grupo_id) === String(grupo.id) ? 'selected' : '' %>><%= grupo.clave %> · Semestre <%= grupo.semestre %> · <%= grupo.turno_nombre %> · <%= grupo.ciclo_escolar %></option>
              <% }); %>
            </select>
          </div>

          <div class="admin-form-group">
            <label for="password">Contraseña</label>
            <input id="password" name="password" type="password" required minlength="12" autocomplete="new-password">
          </div>

          <div class="admin-form-group">
            <label for="password_confirmacion">Confirmar contraseña</label>
            <input id="password_confirmacion" name="password_confirmacion" type="password" required minlength="12" autocomplete="new-password">
          </div>
        </div>

        <div class="admin-form-actions">
          <button type="submit" class="btn-admin-primary">Guardar usuario</button>
          <a href="/admin/usuarios" class="btn-admin-secondary">Cancelar</a>
        </div>
      </form>
    </section>

  </main>

</div>

<script src="/js/adminUserRoleFields.js" defer></script>

</body>
</html>
