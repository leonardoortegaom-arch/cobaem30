<!DOCTYPE html>
<html lang="es">

<%- include('../../partials/head', { title }) %>

<body>

<div class="dashboard-layout">

  <%- include('../../partials/sidebar', { menuItems }) %>

  <main class="dashboard-main">

    <header class="dashboard-header">
      <div>
        <h1>Administración de usuarios</h1>
        <p>Consulta de usuarios registrados y sus roles dentro de la plataforma.</p>
      </div>

      <div class="user-profile">
        <div class="user-avatar">A</div>
        <div>
          <strong>Administrador</strong>
          <span>Consulta de usuarios</span>
        </div>
      </div>
    </header>

    <% if (mensaje) { %>
      <div class="alert alert-success" role="alert">
        <%= mensaje %>
      </div>
    <% } %>

    <section class="panel-card">
      <div class="panel-header">
        <h3>Usuarios registrados</h3>
        <a href="/admin/usuarios/nuevo" class="btn-admin-primary">Crear usuario</a>
      </div>

      <form id="usuarios-filtros" method="GET" action="/admin/usuarios" class="admin-user-filters">
        <div class="admin-filter-field admin-filter-search">
          <label for="usuarios-filtro-q">Buscar</label>
          <input id="usuarios-filtro-q" name="q" type="search" value="<%= filtros.q %>" maxlength="100" placeholder="Nombre, apellido o correo">
        </div>

        <div class="admin-filter-field">
          <label for="usuarios-filtro-rol">Rol</label>
          <select id="usuarios-filtro-rol" name="rol">
            <option value="">Todos los roles</option>
            <% roles.forEach((rol) => { %>
              <option value="<%= rol.clave %>" <%= filtros.rol === rol.clave ? 'selected' : '' %>><%= rol.nombre %></option>
            <% }); %>
          </select>
        </div>

        <div class="admin-filter-field">
          <label for="usuarios-filtro-estado">Estado</label>
          <select id="usuarios-filtro-estado" name="estado">
            <option value="">Todos</option>
            <option value="activo" <%= filtros.estado === 'activo' ? 'selected' : '' %>>Activos</option>
            <option value="inactivo" <%= filtros.estado === 'inactivo' ? 'selected' : '' %>>Inactivos</option>
          </select>
        </div>

        <div class="admin-filter-actions">
          <button type="submit" class="btn-admin-primary">Buscar</button>
          <a href="/admin/usuarios" class="btn-admin-secondary">Limpiar filtros</a>
        </div>
      </form>

      <p class="admin-filter-hint">Los resultados se actualizan automáticamente.</p>

      <p class="admin-results-count"><%= paginacion.totalRegistros %> usuarios encontrados</p>

      <div class="table-responsive">
        <table class="custom-table">
          <thead>
            <tr>
              <th>Nombre completo</th>
              <th>Correo</th>
              <th>Rol</th>
              <th>Estado</th>
              <th>Último acceso</th>
              <th>Fecha de registro</th>
              <th>Acciones</th>
            </tr>
          </thead>

          <tbody>
            <% if (usuarios.length === 0) { %>
              <tr>
                <td colspan="7" class="text-center">No se encontraron usuarios con los filtros seleccionados.</td>
              </tr>
            <% } else { %>
              <% usuarios.forEach((usuario) => { %>
                <tr>
                  <td><%= [usuario.nombre, usuario.apellido_paterno, usuario.apellido_materno].filter(Boolean).join(' ') %></td>
                  <td><%= usuario.correo %></td>
                  <td><%= usuario.rol_nombre %></td>
                  <td>
                    <span class="badge-custom <%= usuario.activo ? 'success' : 'warning' %>">
                      <%= usuario.activo ? 'Activo' : 'Inactivo' %>
                    </span>
                  </td>
                  <td><%= usuario.ultimo_acceso ? new Date(usuario.ultimo_acceso).toLocaleString('es-MX') : 'Sin registro' %></td>
                  <td><%= new Date(usuario.creado_en).toLocaleString('es-MX') %></td>
                  <td>
                    <div class="admin-table-actions">
                      <a href="/admin/usuarios/<%= usuario.id %>/editar" class="btn-admin-edit">Editar</a>
                      <% if (usuario.rol_clave === 'ALUMNO') { %>
                        <a href="/admin/usuarios/<%= usuario.id %>/alumno" class="btn-admin-password">Perfil académico</a>
                      <% } %>
                      <% if (Number(usuario.id) === Number(usuarioActualId)) { %>
                        <span class="admin-current-account">Cuenta actual</span>
                      <% } else { %>
                        <a href="/admin/usuarios/<%= usuario.id %>/contrasena" class="btn-admin-password">Restablecer contraseña</a>
                        <% if (usuario.activo) { %>
                          <a href="/admin/usuarios/<%= usuario.id %>/estado" class="btn-admin-state-danger">Desactivar</a>
                        <% } else { %>
                          <a href="/admin/usuarios/<%= usuario.id %>/estado" class="btn-admin-state-activate">Activar</a>
                        <% } %>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>

      <% if (paginacion.totalPaginas > 1) { %>
        <nav class="admin-pagination" aria-label="Paginación de usuarios">
          <% if (paginacion.tieneAnterior) { %>
            <a href="<%= paginacion.urlAnterior %>" class="admin-page-link">Anterior</a>
          <% } else { %>
            <span class="admin-page-link disabled">Anterior</span>
          <% } %>

          <% paginacion.enlaces.forEach((enlace) => { %>
            <a href="<%= enlace.url %>" class="admin-page-link <%= enlace.actual ? 'active' : '' %>" <%= enlace.actual ? 'aria-current="page"' : '' %>><%= enlace.numero %></a>
          <% }); %>

          <% if (paginacion.tieneSiguiente) { %>
            <a href="<%= paginacion.urlSiguiente %>" class="admin-page-link">Siguiente</a>
          <% } else { %>
            <span class="admin-page-link disabled">Siguiente</span>
          <% } %>
        </nav>
      <% } %>
    </section>

  </main>

</div>

<script src="/js/adminUserFilters.js" defer></script>

</body>
</html>
