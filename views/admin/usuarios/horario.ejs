<!DOCTYPE html>
<html lang="es">
<%- include('../../partials/head', { title }) %>
<body>
<div class="dashboard-layout"><%- include('../../partials/sidebar', { menuItems }) %><main class="dashboard-main teacher-schedule-page">
  <header class="teacher-schedule-title"><div><h1>Horario de trabajo docente</h1><p><strong>Docente:</strong> <%= [docente.nombre, docente.apellido_paterno, docente.apellido_materno].filter(Boolean).join(' ') %> <span>|</span> <strong>Departamento:</strong> Sin registrar <span>|</span> <strong>Ciclo:</strong> Sin registrar</p></div><div class="teacher-schedule-logo">Logotipo<br>institucional</div></header>
  <% if (error) { %><div class="alert alert-danger" role="alert"><%= error %></div><% } %>
  <% if (exito) { %><div class="alert alert-success" role="alert"><%= eliminado ? 'Horario eliminado correctamente.' : 'Horario guardado correctamente.' %></div><% } %>
  <section class="panel-card admin-form-card"><div class="panel-header"><h2>Importar horario desde Excel</h2></div><p>Usa las columnas <strong>HORA</strong>, <strong>LUNES</strong> a <strong>SÁBADO</strong>. En cada celda escribe <strong>Materia [Grupo 123]</strong>.</p><form method="POST" action="/admin/usuarios/<%= docente.id %>/horario" enctype="multipart/form-data" data-csrf-upload="<%= csrfToken %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="admin-form-group"><label for="archivo">Archivo Excel</label><input id="archivo" name="archivo" type="file" accept=".xlsx,.xls" required></div><div class="admin-form-actions"><button type="submit" class="btn-admin-primary">Importar horario</button><a href="/admin/usuarios" class="btn-admin-secondary">Volver</a></div></form><form method="POST" action="/admin/usuarios/<%= docente.id %>/horario/eliminar" onsubmit="return window.confirm('¿Eliminar todo el horario de este docente?');"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="admin-form-actions"><button type="submit" class="btn-admin-state-danger">Eliminar horario</button></div></form></section>
  <section class="teacher-schedule-sheet"><div class="table-responsive"><table class="teacher-schedule-table"><thead><tr><th>Hora</th><% dias.forEach((dia) => { %><th><%= nombresDias[dia] %></th><% }); %></tr></thead><tbody><% for (let hour = 7; hour < 14; hour += 1) { const inicio = `${String(hour).padStart(2, '0')}:00:00`; const fin = `${String(hour + 1).padStart(2, '0')}:00:00`; %><tr><th><%= hour %>:00/<%= hour + 1 %>:00</th><% dias.forEach((dia) => { const clase = clases.find((item) => item.dia === dia && item.hora_inicio === inicio && item.hora_fin === fin); %><td><% if (clase) { %><strong><%= clase.materia %></strong><small><%= clase.grupo || clase.aula || '' %></small><% } %></td><% }); %></tr><% } %></tbody></table></div></section>
</main></div><script src="/js/adminTeacherHorario.js" defer></script></body></html>