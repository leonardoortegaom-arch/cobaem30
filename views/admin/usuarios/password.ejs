<!DOCTYPE html>
<html lang="es">

<%- include('../../partials/head', { title }) %>

<body>

<div class="dashboard-layout">

  <%- include('../../partials/sidebar', { menuItems }) %>

  <main class="dashboard-main">

    <header class="dashboard-header">
      <div>
        <h1>Restablecer contraseña</h1>
        <p>Define una nueva contraseña para la cuenta seleccionada.</p>
      </div>
    </header>

    <section class="panel-card admin-confirmation-card">
      <% if (error) { %>
        <div class="alert alert-danger" role="alert">
          <%= error %>
        </div>
      <% } %>

      <dl class="admin-user-summary">
        <div>
          <dt>Nombre</dt>
          <dd><%= [usuarioObjetivo.nombre, usuarioObjetivo.apellido_paterno, usuarioObjetivo.apellido_materno].filter(Boolean).join(' ') %></dd>
        </div>
        <div>
          <dt>Correo</dt>
          <dd><%= usuarioObjetivo.correo %></dd>
        </div>
        <div>
          <dt>Rol</dt>
          <dd><%= usuarioObjetivo.rol_nombre %></dd>
        </div>
        <div>
          <dt>Estado</dt>
          <dd><%= usuarioObjetivo.activo ? 'Activo' : 'Inactivo' %></dd>
        </div>
      </dl>

      <p class="admin-password-warning">Las sesiones abiertas de este usuario se cerrarán automáticamente.</p>

      <form method="POST" action="/admin/usuarios/<%= usuarioObjetivo.id %>/contrasena">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="admin-form-grid">
          <div class="admin-form-group">
            <label for="password">Nueva contraseña</label>
            <input id="password" name="password" type="password" autocomplete="new-password" required minlength="12">
          </div>

          <div class="admin-form-group">
            <label for="password_confirmacion">Confirmar contraseña</label>
            <input id="password_confirmacion" name="password_confirmacion" type="password" autocomplete="new-password" required minlength="12">
          </div>
        </div>

        <p class="admin-form-note">La contraseña debe tener al menos 12 caracteres y no superar 72 bytes.</p>

        <div class="admin-form-actions">
          <button type="submit" class="btn-admin-danger">Restablecer contraseña</button>
          <a href="/admin/usuarios" class="btn-admin-secondary">Cancelar</a>
        </div>
      </form>
    </section>

  </main>

</div>

</body>
</html>
