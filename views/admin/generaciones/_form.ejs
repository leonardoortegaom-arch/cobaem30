<% if(error){ %><div class="alert alert-danger" role="alert"><%= error %></div><% } %><form method="POST" action="<%= accion %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="admin-form-grid"><div class="admin-form-group"><label for="anio_inicio">Año inicial</label><input id="anio_inicio" name="anio_inicio" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" value="<%= datos.anioInicio %>" required></div><div class="admin-form-group"><label for="anio_fin">Año final</label><input id="anio_fin" name="anio_fin" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" value="<%= datos.anioFin %>" required></div></div><p class="admin-form-note">La etiqueta se mostrará como AAAA-AAAA. No se copiarán ciclos heredados de grupos.</p><div class="admin-form-actions"><button class="btn-admin-primary"><%= boton %></button><a href="/admin/generaciones" class="btn-admin-secondary">Cancelar</a></div></form>
