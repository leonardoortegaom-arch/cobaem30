<!DOCTYPE html><html lang="es"><%- include('../../partials/head',{title}) %><body><div class="dashboard-layout"><%- include('../../partials/sidebar',{menuItems}) %><main class="dashboard-main"><header class="dashboard-header"><div><h1>Calendario académico</h1><p>Administra las generaciones institucionales sin modificar los datos heredados de grupos.</p></div></header><%- include('../calendario/_nav') %>
<% if(mensaje){ %><div class="alert alert-success" role="alert"><%= mensaje %></div><% } %>
<section class="panel-card"><div class="panel-header"><h2>Generaciones</h2><a href="/admin/generaciones/nuevo" class="btn-admin-primary">Registrar generación</a></div>
<form method="GET" action="/admin/generaciones" class="admin-user-filters"><div class="admin-filter-field"><label for="q">Buscar por años</label><input id="q" name="q" value="<%= filtros.q %>" maxlength="20" placeholder="2026-2029"></div><div class="admin-filter-field"><label for="estado">Estado</label><select id="estado" name="estado"><option value="">Todos</option><option value="activo" <%= filtros.estado==='activo'?'selected':'' %>>Activas</option><option value="inactivo" <%= filtros.estado==='inactivo'?'selected':'' %>>Inactivas</option></select></div><div class="admin-filter-actions"><button class="btn-admin-primary">Buscar</button><a href="/admin/generaciones" class="btn-admin-secondary">Limpiar</a></div></form>
<p class="admin-results-count"><%= paginacion.totalRegistros %> generaciones encontradas</p><div class="table-responsive"><table class="custom-table"><thead><tr><th>Generación</th><th>Estado</th><th>Fecha de registro</th><th>Acciones</th></tr></thead><tbody><% if(!generaciones.length){ %><tr><td colspan="4" class="text-center">No se encontraron generaciones.</td></tr><% } else generaciones.forEach(g=>{ %><tr><td><%= g.anio_inicio %>-<%= g.anio_fin %></td><td><span class="badge-custom <%= g.activo?'success':'warning' %>"><%= g.activo?'Activa':'Inactiva' %></span></td><td><%= new Date(g.creado_en).toLocaleDateString('es-MX') %></td><td><div class="admin-table-actions"><a href="/admin/generaciones/<%= g.id %>/editar" class="btn-admin-edit">Editar</a><a href="/admin/generaciones/<%= g.id %>/estado" class="<%= g.activo?'btn-admin-state-danger':'btn-admin-state-activate' %>"><%= g.activo?'Desactivar':'Activar' %></a></div></td></tr><% }); %></tbody></table></div><%- include('../calendario/_pagination',{paginacion}) %></section></main></div></body></html>
