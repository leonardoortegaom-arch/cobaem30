<!DOCTYPE html>
<html lang="es">
<%- include('../../partials/head', { title }) %>
<body>
<div class="dashboard-layout">
  <%- include('../../partials/sidebar', { menuItems }) %>
  <main class="dashboard-main">
    <header class="dashboard-header">
      <div>
        <h1>Horario del grupo</h1>
        <p>Grupo <strong><%= grupo.clave %></strong> · Semestre <strong><%= grupo.semestre %></strong> · <%= grupo.turno_nombre %></p>
      </div>
    </header>
    <% if (error) { %><div class="alert alert-danger" role="alert"><%= error %></div><% } %>
    <% if (exito) { %><div class="alert alert-success" role="alert"><%= eliminado ? 'Horario eliminado correctamente.' : 'Horario guardado correctamente.' %></div><% } %>
    <section class="panel-card admin-form-card">
      <div class="panel-header"><h2>Importar horario desde Excel</h2></div>
      <p>Usa la plantilla semanal con las columnas <strong>HORA</strong>, <strong>LUNES</strong>, <strong>MARTES</strong>, <strong>MIÉRCOLES</strong>, <strong>JUEVES</strong>, <strong>VIERNES</strong> y <strong>SÁBADO</strong>.</p>
      <p class="admin-form-note">Solo se importan bloques de 07:00 a 14:00. Escribe la materia y, opcionalmente, el aula entre corchetes: <strong>Matemáticas [Aula 3]</strong>.</p>
      <form id="grupo-horario-upload-form" method="POST" action="/admin/grupos/<%= grupo.id %>/horario" enctype="multipart/form-data" data-csrf-token="<%= csrfToken %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="admin-form-group"><label for="archivo">Archivo Excel</label><input id="archivo" name="archivo" type="file" accept=".xlsx,.xls" required></div>
        <div class="admin-form-actions"><button type="submit" class="btn-admin-primary">Importar horario</button><a href="/admin/grupos" class="btn-admin-secondary">Volver a grupos</a></div>
      </form>
      <form method="POST" action="/admin/grupos/<%= grupo.id %>/horario/eliminar" onsubmit="return window.confirm('¿Eliminar todo el horario de este grupo?');">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="admin-form-actions"><button type="submit" class="btn-admin-state-danger">Eliminar horario</button></div>
      </form>
    </section>
    <section class="panel-card">
      <div class="panel-header"><h2>Horario semanal</h2></div>
      <div class="table-responsive">
        <table class="custom-table group-schedule-table">
          <thead><tr><th>Hora</th><% dias.forEach((dia) => { %><th><%= nombresDias[dia] %></th><% }); %></tr></thead>
          <tbody>
            <% for (let hour = 7; hour < 14; hour += 1) { const inicio = `${String(hour).padStart(2, '0')}:00:00`; const fin = `${String(hour + 1).padStart(2, '0')}:00:00`; %>
              <tr><th><%= String(hour).padStart(2, '0') %>:00/<%= String(hour + 1).padStart(2, '0') %>:00</th><% dias.forEach((dia) => { const clase = clases.find((item) => item.dia === dia && item.hora_inicio === inicio && item.hora_fin === fin); %><td><% if (clase) { %><strong><%= clase.materia %></strong><small><%= clase.aula || '' %></small><% } %></td><% }); %></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </section>
  </main>
</div>
<script src="/js/adminGroupHorario.js" defer></script>
</body>
</html>