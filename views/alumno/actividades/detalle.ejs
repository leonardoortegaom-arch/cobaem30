<!DOCTYPE html>
<html lang="es">
<%- include('../../partials/head', { title }) %>
<body>
<div class="dashboard-layout">
  <%- include('../../partials/sidebar', { menuItems }) %>
  <main class="dashboard-main student-activity-detail">
    <nav class="student-activity-breadcrumb" aria-label="Ruta de navegación"><a href="/alumno/actividades">Mis actividades</a><span aria-hidden="true">/</span><span>Detalle</span></nav>
    <header class="student-activity-detail-header">
      <div>
        <div class="student-activity-row-badges">
          <span class="student-activity-badge state-<%= actividad.estadoClave.toLowerCase() %>"><%= actividad.estadoNombre %></span>
          <span class="student-activity-temporal temporal-<%= actividad.indicadorTemporal.toLowerCase().replaceAll(' ', '-') %>"><%= actividad.indicadorTemporal %></span>
        </div>
        <h1><%= actividad.titulo %></h1>
        <p><%= actividad.explicacionEstado %></p>
      </div>
      <a href="/alumno/actividades" class="student-activity-back">Volver a mis actividades</a>
    </header>

    <% if (evidencia.mensaje) { %><div class="student-activity-evidence-success" role="status"><%= evidencia.mensaje %></div><% } %>

    <div class="student-activity-detail-grid">
      <div class="student-activity-detail-main">
        <section class="student-activity-detail-panel" aria-labelledby="instrucciones-titulo">
          <div class="student-activity-detail-section-title"><i class="fa-solid fa-clipboard-list" aria-hidden="true"></i><h2 id="instrucciones-titulo">Instrucciones</h2></div>
          <p class="student-activity-instructions"><%= actividad.instrucciones %></p>
        </section>

        <section class="student-activity-detail-panel student-activity-evidence-panel" aria-labelledby="evidencias-titulo">
          <div class="student-activity-evidence-heading">
            <div><div class="student-activity-detail-section-title"><i class="fa-solid fa-paperclip" aria-hidden="true"></i><h2 id="evidencias-titulo">Evidencias de la actividad</h2></div><p>Adjunta fotografías, videos o documentos relacionados con esta actividad.</p></div>
            <span><%= evidencia.cantidadActual %> de <%= evidencia.maximoArchivos %> archivos</span>
          </div>

          <% if (actividad.estadoClave === 'RECHAZADA') { %>
            <div class="student-activity-evidence-readonly student-activity-evidence-correction" role="status"><i class="fa-solid fa-rotate" aria-hidden="true"></i><p>La evidencia requiere correcciones. Puedes eliminar o adjuntar archivos y volver a enviarla.</p></div>
          <% } else if (actividad.estadoClave === 'REALIZADA') { %>
            <div class="student-activity-evidence-readonly student-activity-evidence-reviewed" role="status"><i class="fa-solid fa-circle-check" aria-hidden="true"></i><p>Evidencia enviada. Está pendiente de revisión.</p></div>
          <% } %>

          <% if (evidencia.puedeAdjuntar) { %>
            <div id="student-activity-evidence-uploader" class="student-activity-evidence-uploader" data-upload-url="/alumno/actividades/<%= actividad.id %>/evidencias" data-csrf-token="<%= csrfToken %>" data-current-count="<%= evidencia.cantidadActual %>" data-current-bytes="<%= evidencia.bytesUtilizados %>">
              <div id="student-activity-evidence-dropzone" class="student-activity-evidence-dropzone" tabindex="0" role="button" aria-controls="student-activity-evidence-input">
                <i class="fa-solid fa-cloud-arrow-up" aria-hidden="true"></i>
                <strong>Arrastra tus archivos aquí o selecciónalos desde tu dispositivo.</strong>
                <span>Hasta 5 archivos, 50 MB por archivo y 100 MB en total.</span>
                <label for="student-activity-evidence-input">Seleccionar archivos</label>
                <input id="student-activity-evidence-input" type="file" name="evidencias" multiple accept="image/jpeg,image/png,image/webp,image/gif,video/mp4,video/webm,video/quicktime,application/pdf,.docx,.xlsx,.pptx">
              </div>
              <ul id="student-activity-evidence-selection" class="student-activity-evidence-selection" aria-label="Archivos seleccionados"></ul>
              <div id="student-activity-evidence-progress" class="student-activity-evidence-progress" hidden><div></div></div>
              <p id="student-activity-evidence-message" class="student-activity-evidence-message" aria-live="polite"></p>
              <button id="student-activity-evidence-submit" type="button" class="student-activity-evidence-submit" disabled>Enviar evidencia</button>
            </div>
          <% } else if (['REALIZADA', 'NO_REALIZADA', 'CANCELADA'].includes(actividad.estadoClave)) { %>
            <div class="student-activity-evidence-readonly"><i class="fa-solid fa-lock" aria-hidden="true"></i><p>La actividad está cerrada. Las evidencias permanecen disponibles para consulta y descarga.</p></div>
          <% } else { %>
            <div class="student-activity-evidence-readonly"><i class="fa-solid fa-circle-info" aria-hidden="true"></i><p>Se alcanzó el límite de evidencias permitido para esta actividad.</p></div>
          <% } %>

          <% if (adjuntos.length === 0) { %>
            <div class="student-activity-evidence-empty"><i class="fa-regular fa-folder-open" aria-hidden="true"></i><p>Todavía no has adjuntado evidencias para esta actividad.</p></div>
          <% } else { %>
            <div class="student-activity-evidence-list">
              <% adjuntos.forEach((adjunto) => { %>
                <article class="student-activity-evidence-row">
                  <i class="fa-solid <%= adjunto.mimeType.startsWith('image/') ? 'fa-file-image' : adjunto.mimeType.startsWith('video/') ? 'fa-file-video' : adjunto.extension === 'pdf' ? 'fa-file-pdf' : 'fa-file-lines' %>" aria-hidden="true"></i>
                  <div class="student-activity-evidence-info"><strong><%= adjunto.nombreOriginal %></strong><span><%= adjunto.extension.toUpperCase() %> · <%= adjunto.tamanoBytes < 1048576 ? `${Math.max(1, Math.round(adjunto.tamanoBytes / 1024))} KB` : `${(adjunto.tamanoBytes / 1048576).toFixed(1)} MB` %> · <%= new Date(adjunto.creadoEn).toLocaleDateString('es-MX') %></span></div>
                  <div class="student-activity-evidence-actions">
                    <a href="/alumno/actividades/<%= actividad.id %>/evidencias/<%= adjunto.id %>/descargar">Descargar</a>
                    <% if (adjunto.puedeEliminar) { %>
                      <form method="POST" action="/alumno/actividades/<%= actividad.id %>/evidencias/<%= adjunto.id %>/eliminar" class="student-activity-evidence-delete-form">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit">Eliminar</button>
                      </form>
                    <% } %>
                  </div>
                </article>
              <% }); %>
            </div>
          <% } %>
        </section>
      </div>
      <aside class="student-activity-detail-side">
        <section class="student-activity-detail-panel" aria-labelledby="fechas-titulo">
          <div class="student-activity-detail-section-title"><i class="fa-regular fa-calendar" aria-hidden="true"></i><h2 id="fechas-titulo">Información temporal</h2></div>
          <dl class="student-activity-detail-meta">
            <div><dt>Fecha programada</dt><dd><%= new Date(actividad.fechaAsignacion).toLocaleDateString('es-MX', { timeZone: 'UTC' }) %></dd></div>
            <% if (actividad.fechaRealizacion) { %><div><dt>Fecha de realización</dt><dd><%= new Date(actividad.fechaRealizacion).toLocaleDateString('es-MX', { timeZone: 'UTC' }) %></dd></div><% } %>
            <div><dt>Situación</dt><dd><%= actividad.indicadorTemporal %></dd></div>
          </dl>
        </section>
        <section class="student-activity-detail-panel" aria-labelledby="responsable-titulo">
          <div class="student-activity-detail-section-title"><i class="fa-solid fa-user-tie" aria-hidden="true"></i><h2 id="responsable-titulo">Orientador responsable</h2></div>
          <p><%= actividad.orientadorNombre %></p>
        </section>
      </aside>
    </div>
  </main>
</div>
<script src="/js/alumnoActivityEvidence.js" defer></script>
</body>
</html>
