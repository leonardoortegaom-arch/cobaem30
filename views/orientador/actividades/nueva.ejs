<!DOCTYPE html>
<html lang="es">

<%- include('../../partials/head', { title }) %>

<body>

<div class="dashboard-layout">
  <%- include('../../partials/sidebar', { menuItems }) %>

  <main class="dashboard-main">
    <header class="dashboard-header">
      <div>
        <h1>Programar actividad</h1>
        <p>Asigna una actividad de orientación al alumno seleccionado.</p>
      </div>
    </header>

    <section class="panel-card admin-form-card">
      <dl class="admin-user-summary">
        <div><dt>Alumno</dt><dd><%= alumno.nombreCompleto %></dd></div>
        <div><dt>Matrícula</dt><dd><%= alumno.matricula %></dd></div>
        <div><dt>Grupo</dt><dd><%= alumno.grupoClave %></dd></div>
        <div><dt>Semestre</dt><dd><%= alumno.semestre %></dd></div>
        <div><dt>Turno</dt><dd><%= alumno.turno %></dd></div>
        <div><dt>Ciclo escolar</dt><dd><%= alumno.cicloEscolar %></dd></div>
      </dl>

      <p class="admin-form-note">La actividad se registrará inicialmente con estado “Pendiente”.</p>

      <% if (error) { %>
        <div class="alert alert-danger" role="alert"><%= error %></div>
      <% } %>

      <form method="POST" action="/orientador/alumnos/<%= alumnoId %>/actividades">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="admin-form-grid">
          <div class="admin-form-group admin-form-group-full">
            <label for="titulo">Título</label>
            <input id="titulo" name="titulo" type="text" value="<%= datos.titulo %>" maxlength="150" required autocomplete="off">
          </div>

          <div class="admin-form-group admin-form-group-full">
            <label for="descripcion">Descripción</label>
            <textarea id="descripcion" name="descripcion" rows="8" maxlength="65535" required><%= datos.descripcion %></textarea>
          </div>

          <div class="admin-form-group">
            <label for="fecha_programada">Fecha programada</label>
            <input id="fecha_programada" name="fecha_programada" type="date" value="<%= datos.fecha_programada %>" required>
          </div>
        </div>

        <div class="admin-form-actions">
          <button type="submit" class="btn-admin-primary">Programar actividad</button>
          <a href="/orientador/alumnos/<%= alumnoId %>" class="btn-admin-secondary">Cancelar</a>
        </div>
      </form>
    </section>
  </main>
</div>

</body>
</html>
