<!DOCTYPE html>
<html lang="es">

<%- include('../../partials/head', { title }) %>

<body>

<div class="dashboard-layout">

  <%- include('../../partials/sidebar', { menuItems }) %>

  <main class="dashboard-main">

    <header class="dashboard-header">
      <div>
        <h1>Registrar seguimiento</h1>
        <p>Registra una observación de orientación para el alumno seleccionado.</p>
      </div>
    </header>

    <section class="panel-card admin-form-card">
      <dl class="admin-user-summary">
        <div>
          <dt>Alumno</dt>
          <dd><%= alumno.nombreCompleto %></dd>
        </div>
        <div>
          <dt>Matrícula</dt>
          <dd><%= alumno.matricula %></dd>
        </div>
        <div>
          <dt>Correo</dt>
          <dd><%= alumno.correo %></dd>
        </div>
        <div>
          <dt>Grupo</dt>
          <dd><%= alumno.grupoClave %></dd>
        </div>
      </dl>

      <% if (error) { %>
        <div class="alert alert-danger" role="alert">
          <%= error %>
        </div>
      <% } %>

      <form method="POST" action="/orientador/alumnos/<%= alumnoId %>/seguimientos">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="admin-form-grid">
          <div class="admin-form-group">
            <label for="tipo_id">Tipo de seguimiento</label>
            <select id="tipo_id" name="tipo_id" required>
              <option value="" disabled <%= datos.tipo_id ? '' : 'selected' %>>Selecciona un tipo</option>
              <% tipos.forEach((tipo) => { %>
                <option value="<%= tipo.id %>" <%= String(datos.tipo_id) === String(tipo.id) ? 'selected' : '' %>><%= tipo.nombre %></option>
              <% }); %>
            </select>
          </div>

          <div class="admin-form-group">
            <label for="fecha_seguimiento">Fecha</label>
            <input id="fecha_seguimiento" name="fecha_seguimiento" type="date" value="<%= datos.fecha_seguimiento %>" required>
          </div>

          <div class="admin-form-group admin-form-group-full">
            <label for="titulo">Título</label>
            <input id="titulo" name="titulo" type="text" value="<%= datos.titulo %>" maxlength="150" required autocomplete="off">
          </div>

          <div class="admin-form-group admin-form-group-full">
            <label for="descripcion">Descripción</label>
            <textarea id="descripcion" name="descripcion" maxlength="5000" rows="8" required><%= datos.descripcion %></textarea>
          </div>
        </div>

        <div class="admin-form-actions">
          <button type="submit" class="btn-admin-primary">Registrar seguimiento</button>
          <a href="/orientador/alumnos/<%= alumnoId %>" class="btn-admin-secondary">Cancelar</a>
        </div>
      </form>
    </section>

  </main>

</div>

</body>
</html>
