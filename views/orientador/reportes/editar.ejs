<!DOCTYPE html><html lang="es">
<%- include('../../partials/head', { title }) %><body><div class="dashboard-layout">
  <%- include('../../partials/sidebar', { menuItems }) %>
  <main class="dashboard-main written-report-main">
    <nav class="report-breadcrumb" aria-label="Ruta de navegación"><a href="/orientador/reportes">Reportes</a><span aria-hidden="true">/</span><span aria-current="page">Editar borrador</span></nav>
    <% if (mensaje) { %><div class="alert alert-success" role="status"><%= mensaje %></div><% } %>
    <header class="written-report-hero"><div><span class="badge-custom warning"><%= reporte.estadoNombre %></span><h1>Editar borrador</h1><p>Continúa redactando el reporte y guarda los cambios antes de salir.</p></div>
      <div class="written-report-header-actions"><a href="<%= apoyoUrl %>" class="btn-admin-secondary">Consultar información de apoyo</a><a href="/orientador/reportes" class="btn-admin-secondary">Volver a Reportes</a></div>
    </header>
    <div class="written-report-layout">
      <form method="POST" action="/orientador/reportes/<%= reporte.id %>/editar" class="panel-card written-report-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= version %>">
        <% if (error) { %><div class="alert alert-danger" role="alert"><%= error %></div><% } %>
        <%- include('_campos', { tipos, datos }) %>
        <div class="admin-form-actions"><button type="submit" class="btn-admin-primary">Guardar cambios</button><a href="/orientador/reportes" class="btn-admin-secondary">Volver a Reportes</a></div>
      </form>
      <aside class="written-report-aside">
        <section class="panel-card written-report-student-card"><h2>Alumno</h2><dl class="orientation-activity-detail-data">
          <div><dt>Nombre</dt><dd><%= alumno.nombre %></dd></div><div><dt>Matrícula</dt><dd><%= alumno.matricula %></dd></div><div><dt>Grupo</dt><dd><%= alumno.grupo %></dd></div>
          <div><dt>Semestre</dt><dd><%= alumno.semestre %></dd></div><div><dt>Turno</dt><dd><%= alumno.turno %></dd></div><div><dt>Ciclo escolar</dt><dd><%= alumno.ciclo %></dd></div>
        </dl></section>
        <section class="panel-card written-report-meta-card"><h2>Documento</h2><dl class="orientation-activity-detail-data">
          <div><dt>Fecha oficial</dt><dd><%= reporte.fechaReporte %></dd></div><div><dt>Última actualización</dt><dd><%= new Date(reporte.actualizadoEn).toLocaleString('es-MX') %></dd></div>
        </dl></section>
      </aside>
    </div>
  </main>
</div></body></html>
