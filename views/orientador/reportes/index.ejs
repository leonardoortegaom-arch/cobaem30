<!DOCTYPE html>
<html lang="es">

<%- include('../../partials/head', { title }) %>

<body>
<div class="dashboard-layout">
  <%- include('../../partials/sidebar', { menuItems }) %>
  <main class="dashboard-main">
    <header class="dashboard-header">
      <div><h1>Reportes</h1><p>Selecciona un alumno para redactar un reporte académico o conductual.</p></div>
    </header>

    <section class="panel-card written-report-drafts">
      <div class="panel-header"><div><h2>Mis borradores recientes</h2><p>Continúa los reportes que todavía están en elaboración.</p></div></div>
      <% if (borradores.length === 0) { %>
        <p class="text-center">No tienes borradores pendientes.</p>
      <% } else { %>
        <div class="table-responsive"><table class="custom-table">
          <thead><tr><th>Alumno</th><th>Matrícula</th><th>Tipo</th><th>Motivo</th><th>Periodo</th><th>Fecha</th><th>Actualización</th><th>Acción</th></tr></thead>
          <tbody><% borradores.forEach((borrador) => { %><tr>
            <td><%= borrador.alumno_nombre %></td><td><%= borrador.matricula %></td><td><%= borrador.tipo_nombre %></td><td><%= borrador.motivo %></td>
            <td><%= borrador.periodo_desde %> a <%= borrador.periodo_hasta %></td><td><%= borrador.fecha_reporte %></td><td><%= new Date(borrador.actualizado_en).toLocaleString('es-MX') %></td>
            <td><a href="/orientador/reportes/<%= borrador.id %>/editar" class="btn-admin-edit">Continuar redactando</a></td>
          </tr><% }); %></tbody>
        </table></div>
      <% } %>
    </section>

    <section class="panel-card">
      <form id="reportes-filtros" method="GET" action="/orientador/reportes" class="admin-user-filters">
        <div class="admin-filter-field">
          <label for="reportes-filtro-q">Buscar</label>
          <input id="reportes-filtro-q" name="q" type="search" value="<%= filtros.q %>" maxlength="100" placeholder="Matrícula, nombre o correo">
        </div>
        <div class="admin-filter-field">
          <label for="reportes-filtro-grupo">Grupo</label>
          <select id="reportes-filtro-grupo" name="grupo">
            <option value="">Todos los grupos</option>
            <% grupos.forEach((grupo) => { %>
              <option value="<%= grupo.id %>" <%= filtros.grupo === String(grupo.id) ? 'selected' : '' %>><%= grupo.clave %> · Semestre <%= grupo.semestre %> · <%= grupo.turno_nombre %> · <%= grupo.ciclo_escolar %><%= grupo.activo ? '' : ' · Inactivo' %></option>
            <% }); %>
          </select>
        </div>
        <div class="admin-filter-field">
          <label for="reportes-filtro-estado">Estado de cuenta</label>
          <select id="reportes-filtro-estado" name="estado">
            <option value="">Todos</option>
            <option value="activo" <%= filtros.estado === 'activo' ? 'selected' : '' %>>Activos</option>
            <option value="inactivo" <%= filtros.estado === 'inactivo' ? 'selected' : '' %>>Inactivos</option>
          </select>
        </div>
        <div class="admin-filter-actions">
          <button type="submit" class="btn-admin-primary">Buscar</button>
          <a href="/orientador/reportes" class="btn-admin-secondary">Limpiar</a>
        </div>
      </form>
      <p class="admin-filter-hint">Los resultados se actualizan automáticamente.</p>
      <p class="admin-results-count"><%= paginacion.totalRegistros %> alumnos encontrados</p>

      <div class="table-responsive">
        <table class="custom-table">
          <thead><tr><th>Matrícula</th><th>Alumno</th><th>Correo</th><th>Grupo</th><th>Semestre</th><th>Turno</th><th>Ciclo</th><th>Estado</th><th>Acción</th></tr></thead>
          <tbody>
            <% if (alumnos.length === 0) { %>
              <tr><td colspan="9" class="text-center"><%= grupos.length === 0 ? 'No tienes grupos asignados actualmente.' : 'No se encontraron alumnos con los filtros seleccionados.' %></td></tr>
            <% } else { %>
              <% alumnos.forEach((alumno) => { %>
                <tr>
                  <td><%= alumno.matricula %></td><td><%= alumno.nombre_completo %></td><td><%= alumno.correo %></td>
                  <td><%= alumno.grupo_clave %></td><td><%= alumno.semestre %></td><td><%= alumno.turno_nombre %></td><td><%= alumno.ciclo_escolar %></td>
                  <td><span class="badge-custom <%= alumno.usuario_activo ? 'success' : 'warning' %>"><%= alumno.usuario_activo ? 'Activo' : 'Inactivo' %></span></td>
                  <td><a href="/orientador/reportes/alumnos/<%= alumno.usuarioId %>" class="btn-admin-edit">Redactar reporte</a></td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>

      <% if (paginacion.totalPaginas > 1) { %>
        <nav class="admin-pagination" aria-label="Paginación de alumnos para reportes">
          <% if (paginacion.tieneAnterior) { %><a href="<%= paginacion.urlAnterior %>" class="admin-page-link">Anterior</a><% } else { %><span class="admin-page-link disabled">Anterior</span><% } %>
          <% paginacion.enlaces.forEach((enlace) => { %><a href="<%= enlace.url %>" class="admin-page-link <%= enlace.actual ? 'active' : '' %>" <% if (enlace.actual) { %>aria-current="page"<% } %>><%= enlace.numero %></a><% }); %>
          <% if (paginacion.tieneSiguiente) { %><a href="<%= paginacion.urlSiguiente %>" class="admin-page-link">Siguiente</a><% } else { %><span class="admin-page-link disabled">Siguiente</span><% } %>
        </nav>
      <% } %>
    </section>
  </main>
</div>
<script src="/js/orientadorReportFilters.js" defer></script>
</body>
</html>
