<!DOCTYPE html>
<html lang="es">

<%- include('../partials/head', { title: 'Orientador | COBAEM 30' }) %>

<body>
<div class="dashboard-layout">
  <%- include('../partials/sidebar', { menuItems }) %>

  <main class="dashboard-main orientation-dashboard">
    <% if (typeof sinGruposAsignados !== 'undefined' && sinGruposAsignados) { %>
      <div class="alert alert-info" role="status">No tienes grupos asignados actualmente.</div>
    <% } %>
    <header class="dashboard-header orientation-dashboard-title">
      <h1>Panel de orientador</h1>
    </header>

    <section class="dashboard-stats orientation-dashboard-stats" aria-label="Resumen de orientación">
      <article class="dashboard-card orientation-dashboard-metric">
        <i class="fa-solid fa-user-graduate" aria-hidden="true"></i>
        <div><h3><%= metricas.totalAlumnosActivos %></h3><p>Alumnos activos</p></div>
      </article>
      <article class="dashboard-card orientation-dashboard-metric">
        <i class="fa-solid fa-clipboard-list" aria-hidden="true"></i>
        <div><h3><%= metricas.seguimientosMes %></h3><p>Seguimientos del mes</p></div>
      </article>
      <article class="dashboard-card orientation-dashboard-metric">
        <i class="fa-solid fa-list-check" aria-hidden="true"></i>
        <div><h3><%= metricas.actividadesAbiertas %></h3><p>Actividades abiertas</p></div>
      </article>
      <article class="dashboard-card orientation-dashboard-metric">
        <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
        <div>
          <h3><%= metricas.actividadesVencidas %></h3>
          <p>Actividades vencidas</p>
          <span class="orientation-dashboard-status <%= metricas.actividadesVencidas > 0 ? 'is-alert' : 'is-clear' %>">
            <%= metricas.actividadesVencidas > 0 ? 'Requieren atención' : 'Sin vencidas' %>
          </span>
        </div>
      </article>
    </section>

    <section class="dashboard-grid orientation-dashboard-grid">
      <div class="orientation-dashboard-main-column">
        <section class="panel-card" aria-labelledby="prioridades-titulo">
          <div class="panel-header orientation-dashboard-panel-header">
            <div>
              <h2 id="prioridades-titulo">Prioridades de atención</h2>
              <p>Actividades pendientes o vencidas que requieren seguimiento.</p>
            </div>
            <a href="/orientador/seguimientos">Ver todas <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
          </div>

          <% if (actividades.length === 0) { %>
            <div class="orientation-dashboard-empty">
              <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
              <div><strong>No tienes actividades pendientes por atender.</strong><a href="/orientador/seguimientos">Ir al seguimiento general</a></div>
            </div>
          <% } else { %>
            <div class="orientation-dashboard-priority-list">
              <% actividades.forEach((actividad) => { %>
                <article class="orientation-dashboard-priority-row">
                  <div class="orientation-dashboard-priority-main">
                    <h3><%= actividad.titulo %></h3>
                    <p><%= actividad.alumno_nombre %> · <%= actividad.matricula %> · Grupo <%= actividad.grupo_clave %></p>
                  </div>
                  <div class="orientation-dashboard-priority-meta">
                    <span class="badge-custom <%= actividad.vencida ? 'danger' : actividad.estado_clave === 'EN_PROCESO' ? 'success' : 'warning' %>"><%= actividad.estado_nombre %></span>
                    <% if (actividad.vencida) { %><span class="orientation-dashboard-overdue">Vencida</span><% } %>
                    <time><i class="fa-regular fa-calendar" aria-hidden="true"></i> <%= new Date(actividad.fecha_asignacion).toLocaleDateString('es-MX', { timeZone: 'UTC' }) %></time>
                  </div>
                  <div class="orientation-dashboard-row-actions">
                    <a class="orientation-dashboard-primary-action" href="/orientador/alumnos/<%= actividad.alumno_usuario_id %>/actividades/<%= actividad.actividad_id %>/estado">Actualizar estado</a>
                    <a class="orientation-dashboard-secondary-action" href="/orientador/alumnos/<%= actividad.alumno_usuario_id %>">Ver alumno</a>
                  </div>
                </article>
              <% }); %>
            </div>
          <% } %>
        </section>

        <section class="panel-card" aria-labelledby="seguimientos-recientes-titulo">
          <div class="panel-header orientation-dashboard-panel-header">
            <h2 id="seguimientos-recientes-titulo">Seguimientos recientes</h2>
            <a href="/orientador/historial">Ver historial <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
          </div>

          <% if (seguimientos.length === 0) { %>
            <div class="orientation-dashboard-empty">
              <i class="fa-solid fa-clipboard-check" aria-hidden="true"></i>
              <div><strong>Todavía no has registrado seguimientos.</strong><a href="/orientador/alumnos">Seleccionar un alumno</a></div>
            </div>
          <% } else { %>
            <div class="orientation-dashboard-tracking-list">
              <% seguimientos.forEach((seguimiento) => { %>
                <a href="/orientador/alumnos/<%= seguimiento.alumno_usuario_id %>/seguimientos" class="orientation-dashboard-tracking-row">
                  <span class="orientation-dashboard-tracking-icon"><i class="fa-solid fa-clipboard-check" aria-hidden="true"></i></span>
                  <span>
                    <strong><%= seguimiento.titulo %></strong>
                    <small><%= seguimiento.tipo_nombre %> · <%= seguimiento.alumno_nombre %> · <%= seguimiento.matricula %></small>
                  </span>
                  <time><%= new Date(seguimiento.fecha_seguimiento).toLocaleDateString('es-MX', { timeZone: 'UTC' }) %></time>
                  <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                </a>
              <% }); %>
            </div>
          <% } %>
        </section>
      </div>

      <aside class="panel-card orientation-dashboard-quick-panel" aria-labelledby="acciones-rapidas-titulo">
        <div class="panel-header orientation-dashboard-panel-header">
          <div><h2 id="acciones-rapidas-titulo">Acciones rápidas</h2><p>Continúa con una tarea frecuente.</p></div>
        </div>
        <nav class="quick-actions orientation-dashboard-quick-actions" aria-label="Acciones rápidas de orientación">
          <a href="/orientador/alumnos"><i class="fa-solid fa-user-graduate" aria-hidden="true"></i><span><strong>Buscar alumnos</strong><small>Consulta expedientes.</small></span><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></a>
          <a href="/orientador/seguimientos"><i class="fa-solid fa-list-check" aria-hidden="true"></i><span><strong>Revisar pendientes</strong><small>Consulta actividades abiertas.</small></span><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></a>
          <a href="/orientador/reportes"><i class="fa-solid fa-file-lines" aria-hidden="true"></i><span><strong>Preparar reporte</strong><small>Trabaja con reportes de orientación.</small></span><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></a>
          <a href="/orientador/historial"><i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i><span><strong>Consultar historial</strong><small>Revisa registros anteriores.</small></span><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></a>
        </nav>
      </aside>
    </section>
  </main>
</div>
</body>
</html>
